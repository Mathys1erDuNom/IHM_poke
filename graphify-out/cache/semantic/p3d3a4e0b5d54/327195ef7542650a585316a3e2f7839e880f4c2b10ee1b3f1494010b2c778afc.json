{"nodes": [{"id": "readme", "label": "README.md", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_pokedex_des_dresseurs", "label": "Pok\u00e9dex des dresseurs (Flask web app)", "file_type": "concept", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_shared_postgres_database", "label": "Shared Postgres database with the Discord bot", "file_type": "rationale", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app only reads the bot's Postgres database, so it needs no Discord bot token; each HTTP request opens its own DB connection, so bot and web app can run side by side without interfering."}, {"id": "readme_new_captures_table", "label": "new_captures table", "file_type": "concept", "source_file": "README.md", "source_location": "L4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_env_configuration", "label": ".env configuration (DATABASE_URL, FLASK_SECRET_KEY, DISCORD_CLIENT_ID/SECRET, DISCORD_REDIRECT_URI)", "file_type": "concept", "source_file": "README.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DATABASE_URL is the same variable as the bot's; the Discord client secret stays server-side and must never be published."}, {"id": "readme_discord_oauth2_login", "label": "Discord OAuth2 login (identify scope)", "file_type": "concept", "source_file": "README.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_api_endpoints", "label": "REST API endpoints (/api/trainers, /api/trainers/<user_id>/pokemons, /api/search)", "file_type": "concept", "source_file": "README.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_global_pokemon_search", "label": "Global Pok\u00e9mon search across trainers", "file_type": "concept", "source_file": "README.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_combats_pokemon", "label": "Combats Pok\u00e9mon (/combat battle feature)", "file_type": "concept", "source_file": "README.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_wave_mode", "label": "Wave mode (Vagues) progression", "file_type": "concept", "source_file": "README.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimum IV rises by 5 every five waves up to the cap of 31, and offered species progress by base stats, so difficulty scales without levels."}, {"id": "readme_levelless_combat", "label": "Level-less combat (stats from base stats and IVs)", "file_type": "rationale", "source_file": "README.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combat does not use levels: stats are computed directly from base stats and IVs."}, {"id": "readme_data_fallbacks", "label": "Battle data fallbacks (default accuracy 100, no PP, defense fallback 1, Lutte/Struggle)", "file_type": "rationale", "source_file": "README.md", "source_location": "L69", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attack JSON lacks accuracy so a configured default of 100 is used; PP are not used so moves repeat without limit; two Pok\u00e9mon lack defense so the loader falls back to 1; Lutte is the fallback for a Pok\u00e9mon with no valid attack."}, {"id": "readme_unsupported_attack_effects", "label": "Unsupported attack effects and attack aliases (copie, 